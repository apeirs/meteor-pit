{
  "schemaVersion": 1,
  "id": "meteor-pit",
  "version": "${version}",
  "name": "Meteor Pit",
  "description": "Pit modules for Meteor Client.",
  "authors": ["lucas"],
  "icon": "assets/meteorpit/icon.png",
  "environment": "client",
  "entrypoints": {
    "meteor": ["dev.goldenhead.MeteorPitAddon"]
  },
  "mixins": ["meteor-pit.mixins.json"],
  "custom": {
    "meteor-client:color": "255,200,40",
    "modmenu": { "parent": { "id": "meteor-client" } }
  },
  "depends": {
    "java": ">=21",
    "minecraft": ["${mc_version}"],
    "meteor-client": "*"
  }
}
